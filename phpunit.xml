<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <!--
        "laravel" and "native" groups (see class-level #[Group(...)] attributes on
        tests/Unit/LaravelRuleParserTest.php, tests/Unit/Parity/*Test.php, tests/Unit/NativeCompilerTest.php
        and tests/Unit/Compilation/*Test.php) let CI run and report those subsets as distinctly-named
        checks per PHP/Laravel matrix cell (see .github/workflows/ci.yml and README.md's "Compatibility"
        section) via the phpunit "group" CLI option, without affecting a plain phpunit run.
    -->
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <coverage>
        <report>
            <html outputDirectory="build/coverage"/>
            <clover outputFile="build/logs/clover.xml"/>
        </report>
    </coverage>
</phpunit>

